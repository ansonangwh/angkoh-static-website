---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';
interface Props { title: string; pageClass?: string }
const { title, pageClass } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="Ang &amp; Koh website concept with sample practice areas and meeting preparation guides." />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Ang &amp; Koh</title>
  </head>
  <body class={pageClass}>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content"><slot /></main>
    <Footer />
  </body>
</html>
