---
import Site from '../layouts/Site.astro';
import { updates, practices, url } from '../content';

export function getStaticPaths() {
  return [
    ...practices.map(item => ({ params: { slug: 'practice-areas/' + item.slug }, props: { kind: 'practice' as const, item } })),
    ...updates.map(item => ({ params: { slug: 'news-events/' + item.slug }, props: { kind: 'insight' as const, item } })),
  ];
}

const page = Astro.props;
const title = page.kind === 'practice' ? page.item.name : page.item.title;
const section = page.kind === 'practice' ? { path: 'practice-areas/', label: 'Practice areas' } : { path: 'news-events/', label: 'News & Events' };
---
<Site title={title}>
  <article class="wrap interior prose">
    <a class="back-link" href={url(section.path)}>{section.label}</a>
    <h1>{title}</h1>
    <p class="lede">{page.item.summary}</p>
    {page.kind === 'practice' ? <>
      <h2>Examples of matters</h2>
      <ul>{page.item.examples.map(example => <li>{example}</li>)}</ul>
      <h2>What to prepare</h2>
      <p>{page.item.prepare}</p>
      <a class="button" href={url('contact/')}>Contact</a>
    </> : <>
      {page.item.image && <img class="workshop-image article-image" src={url('assets/' + page.item.image.file)} alt={page.item.image.alt} decoding="async" />}
      {page.item.paragraphs.map(paragraph => <p>{paragraph}</p>)}
    </>}
  </article>
</Site>
