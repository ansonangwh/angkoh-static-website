---
import Brand from './Brand.astro';
import { url } from '../content';

// Replace each demo destination with the lawyer's verified profile URL when available.
const linkedInProfile = url('our-partners/#adrian-tan');
const facebookProfile = url('our-partners/#adrian-tan');
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div><Brand /><p>Website concept · Sample content</p></div>
    <nav aria-label="Footer navigation">
      <a href={url('practice-areas/')}>Practice areas</a>
      <a href={url('news-events/')}>News &amp; Events</a>
      <a href={url('contact/')}>Contact</a>
    </nav>
    <div class="footer-social">
      <p>Lawyer profiles · Demo</p>
      <nav aria-label="Lawyer social profiles">
        <a href={linkedInProfile} aria-label="LinkedIn demo — Adrian Tan’s sample profile" title="LinkedIn · Sample lawyer profile">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M4 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM2.3 9h3.4v12H2.3zM9 9h3.3v1.7c.7-1.2 1.9-2 3.8-2 3.4 0 4.9 2 4.9 5.8V21h-3.5v-6.1c0-2.2-.6-3.1-2.2-3.1-1.8 0-2.8 1.1-2.8 3.3V21H9z"/></svg>
        </a>
        <a href={facebookProfile} aria-label="Facebook demo — Adrian Tan’s sample profile" title="Facebook · Sample lawyer profile">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M14.2 22v-9h3l.5-3.5h-3.5V7.3c0-1 .3-1.7 1.8-1.7H18V2.5c-.6-.1-1.6-.2-2.8-.2-2.9 0-4.8 1.8-4.8 5v2.2H7.2V13h3.2v9z"/></svg>
        </a>
      </nav>
    </div>
  </div>
</footer>
