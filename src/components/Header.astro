---
import Brand from './Brand.astro';
import { navigation, url } from '../content';
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap header-inner">
    <Brand />
    <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav" type="button" hidden>Menu</button>
    <nav id="main-nav" aria-label="Main navigation">
      {navigation.map(({ label, path }) => <a href={url(path)} aria-current={current === url(path) ? 'page' : undefined}>{label}</a>)}
      <a class="header-contact" href={url('contact/')} aria-current={current === url('contact/') ? 'page' : undefined}>Contact</a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const header = toggle.closest('header')!;
  const nav = header.querySelector('nav')!;
  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
  }
  toggle.hidden = false;
  header.classList.add('enhanced');
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') === 'false'));
  header.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
